# ==============================================================================
# DEV ASSISTANT BOT - CONFIGURATION ENVIRONMENT (.env)
# ==============================================================================
# Hướng dẫn: Copy file này thành .env và điền các giá trị phù hợp với hệ thống của bạn:
#   cp .env.example .env
# Lưu ý quan trọng: KHÔNG BAO GIỜ commit file .env chứa key thật lên Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH BOT TELEGRAM CƠ BẢN (BẮT BUỘC)
# ------------------------------------------------------------------------------
# Token của Bot Telegram được cấp bởi @BotFather (https://t.me/BotFather)
BOT_TOKEN=your_telegram_bot_token

# ID Telegram duy nhất của bạn để xác thực quyền truy cập vào bot
# Lấy ID của bạn bằng cách chat với @userinfobot (https://t.me/userinfobot)
AUTHORIZED_TELEGRAM_ID=123456789

# Múi giờ sử dụng cho việc định dạng log và ghi chú cá nhân
TIMEZONE=Asia/Ho_Chi_Minh

# Đường dẫn đến file lưu ghi chú nhanh
NOTES_FILE_PATH=./notes.txt

# Đường dẫn tuyệt đối hoặc tương đối tới file log lỗi của PM2 (dùng cho lệnh /logs)
PM2_ERROR_LOG_PATH=/home/hnt/.pm2/logs/assistant-bot-error.log

# Tên của tiến trình PM2 quản lý bot (dùng cho lệnh /stop hoặc /restart)
PM2_PROCESS_NAME=assistant-bot

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH WEB SANDBOX & DEPLOY TRÊN VPS (MẶC ĐỊNH)
# ------------------------------------------------------------------------------
# Thư mục lưu trữ mã nguồn các web triển khai trên máy chủ
WEB_DEPLOY_DIR=/home/hnt/web

# Thư mục chứa các file build ZIP người dùng upload lên
UPLOAD_DIR=/home/hnt/uploads

# Cổng khởi đầu cấp phát cho các tiến trình Node.js backend nội bộ
WEB_PORT_START=8081

# Tên miền gốc quản lý trên Cloudflare (Dùng để cấp tự động <tên_app>.<base_domain>)
BASE_DOMAIN=thienhn.io.vn

# Đường dẫn file JSON lưu trữ danh mục các dịch vụ đã triển khai
DEPLOY_REGISTRY_PATH=./data/deployments.json

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH CLOUDFLARE DNS API (TÙY CHỌN - ĐỂ ĐĂNG KÝ CNAME CHO VERCEL & RENDER)
# ------------------------------------------------------------------------------
# Dùng để tự động tạo CNAME record trỏ subdomain sang Vercel hoặc Render.
# 
# Cách lấy CLOUDFLARE_API_TOKEN:
#   1. Đăng nhập: https://dash.cloudflare.com/profile/api-tokens
#   2. Bấm "Create Token" -> Chọn Template "Edit zone DNS"
#   3. Tại mục "Zone Resources", chọn "Include" -> "Specific zone" -> Chọn tên miền của bạn (ví dụ: thienhn.io.vn)
#   4. Bấm "Continue to summary" -> "Create Token" -> Sao chép mã token hiển thị.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cách lấy CLOUDFLARE_ZONE_ID:
#   1. Đăng nhập: https://dash.cloudflare.com
#   2. Bấm chọn tên miền của bạn (ví dụ: thienhn.io.vn)
#   3. Tại trang "Overview", cuộn xuống cột bên phải mục "API", sao chép giá trị "Zone ID".
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH VERCEL (TÙY CHỌN - ĐỂ TRIỂN KHAI LÊN VERCEL)
# ------------------------------------------------------------------------------
# Dùng để tự động deploy dự án từ file ZIP hoặc GitHub sang Vercel và gán subdomain.
#
# Cách lấy VERCEL_TOKEN:
#   1. Đăng nhập: https://vercel.com/account/tokens
#   2. Nhập tên mô tả cho Token (ví dụ: assistant-bot)
#   3. Chọn Scope (mặc định Full Account) và Expiration (nên chọn No Expiration)
#   4. Bấm "Create Token" và sao chép mã hiển thị.
VERCEL_TOKEN=your_vercel_personal_access_token_here

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH RENDER (TÙY CHỌN - ĐỂ TRIỂN KHAI LÊN RENDER TỪ GITHUB)
# ------------------------------------------------------------------------------
# Dùng để tự động tạo Static Site / Web Service từ link GitHub public và gán subdomain.
#
# Cách lấy RENDER_API_KEY:
#   1. Đăng nhập: https://dashboard.render.com/u/settings#api-keys
#   2. Bấm "Create API Key", đặt tên (ví dụ: assistant-bot) và sao chép mã API Key.
RENDER_API_KEY=rnd_your_render_api_key_here

# Cách lấy RENDER_OWNER_ID:
#   Cách 1: Chạy lệnh curl nhanh trên terminal máy tính (thay mã RENDER_API_KEY vừa lấy):
#     curl -H "Authorization: Bearer <RENDER_API_KEY>" https://api.render.com/v1/owners
#     Kết quả JSON trả về trường "id" của bạn (dạng: usr-xxxxxxxxxxxxxxxx hoặc tea-xxxxxxxxxxxxxxxx).
#   Cách 2: Vào https://dashboard.render.com -> Nhìn vào URL trình duyệt khi vào Workspace.
RENDER_OWNER_ID=usr_your_render_owner_or_team_id_here

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH WEB DASHBOARD VUE 3 (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Mã PIN / Khóa bảo mật để truy cập vào Web Dashboard (https://dashboard.<base_domain>)
# Bạn tự đặt chuỗi bí mật này (ví dụ: mã PIN 6 số hoặc mật khẩu riêng)
DASHBOARD_SECRET_KEY=my_secure_dashboard_pin_123456

# Cổng chạy API Server nội bộ của Dashboard (Nginx sẽ proxy /api/ về cổng này)
DASHBOARD_PORT=3001

# ------------------------------------------------------------------------------
# 7. TIỆN ÍCH KHÁC (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Google PageSpeed Insights API Key (đo điểm Lighthouse từ xa cho lệnh /perf)
# Lấy miễn phí tại: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
